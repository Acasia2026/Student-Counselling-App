# Environment Configuration Example for Student Counseling & Cognitive Profiling Engine

# Server Settings
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/student_counseling_db?schema=public"

# Security & RBAC Secrets
JWT_SECRET="your_secure_jwt_secret_here"
SUPERADMIN_API_KEY="your_superadmin_master_key_here"

# CORS & Frontend Origins
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
