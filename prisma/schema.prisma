// Prisma Schema for Multi-Tenant Student Counseling & Cognitive Profiling Platform
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  SCHOOL_ADMIN
  TEACHER
  COUNSELOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_PROVISION
}

enum SubscriptionTier {
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  EXPIRED
}

enum DistressLevel {
  LOW
  MEDIUM
  HIGH
  SEVERE
  CRITICAL
}

enum CrisisStatus {
  OPEN
  OVERRIDDEN
  ESCALATED_TO_HUMAN
  RESOLVED
}

// -------------------------------------------------------------
// Multi-Tenant School Entity
// -------------------------------------------------------------
model School {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  domain           String            @unique
  contactEmail     String
  status           TenantStatus      @default(ACTIVE)
  maxStudents      Int               @default(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  subscription     Subscription?
  cognitiveProfiles CognitiveProfile[]
  crisisEscalations CrisisEscalation[]
  auditLogs        AuditLog[]

  @@map("schools")
}

// -------------------------------------------------------------
// Subscriptions & Billing
// -------------------------------------------------------------
model Subscription {
  id           String             @id @default(uuid())
  schoolId     String             @unique
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tier         SubscriptionTier   @default(PREMIUM)
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle String             @default("ANNUAL")
  price        Float
  currency     String             @default("INR")
  startDate    DateTime           @default(now())
  endDate      DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("subscriptions")
}

// -------------------------------------------------------------
// User Management & Staff Directory (School Admin, Teachers, Counselors)
// -------------------------------------------------------------
model User {
  id                String      @id @default(uuid())
  schoolId          String?     // NULL for SUPERADMIN
  school            School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  email             String      @unique
  passwordHash      String?
  phoneNumber       String?
  department        String?     // e.g. Mathematics, Student Wellness, Humanities
  role              Role        @default(STUDENT)
  status            UserStatus  @default(PENDING)
  invitationToken   String?
  assignedClasses   Json?       // JSON array of class IDs / subjects e.g. ["Grade 10-A Math", "Grade 11-B AP Logic"]
  isVerified        Boolean     @default(false)
  parentConsent     Boolean     @default(false)
  resetToken        String?
  resetTokenExpires DateTime?
  lastLogin         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  cognitiveProfiles CognitiveProfile[]
  crisisEscalations CrisisEscalation[]
  auditLogs        AuditLog[]

  @@index([schoolId])
  @@index([role])
  @@index([status])
  @@map("users")
}

// -------------------------------------------------------------
// CHC Cognitive Domains & Profiles (Gf, Gv, Gwm, Gs)
// -------------------------------------------------------------
model ChcDomainWeight {
  id           String   @id @default(uuid())
  gfWeight     Float    @default(0.30)
  gvWeight     Float    @default(0.25)
  gwmWeight    Float    @default(0.25)
  gsWeight     Float    @default(0.20)
  version      Int      @default(1)
  calibratedBy String
  updatedAt    DateTime @updatedAt

  @@map("chc_domain_weights")
}

model CognitiveProfile {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gfScore      Float
  gvScore      Float
  gwmScore     Float
  gsScore      Float
  compositeIq  Float
  riskLevel    String   @default("NORMAL")
  assessedAt   DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@map("cognitive_profiles")
}

// -------------------------------------------------------------
// AI Chatbot Guardrails & Prompts
// -------------------------------------------------------------
model AiGuardrail {
  id                   String   @id @default(uuid())
  chatbotName          String   @default("CBT Counselor Bot v4")
  isGuardrailActive    Boolean  @default(true)
  systemPromptTemplate String   @db.Text
  distressThreshold    Float    @default(0.75)
  sentimentSensitivity Float    @default(0.85)
  maxTokenLimit        Int      @default(1024)
  prohibitedKeywords   String   @db.Text
  updatedAt            DateTime @updatedAt

  @@map("ai_guardrails")
}

// -------------------------------------------------------------
// Crisis Escalation Monitor (SOS Distress Triggers)
// -------------------------------------------------------------
model CrisisEscalation {
  id                String        @id @default(uuid())
  sessionId         String
  studentId         String
  student           User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  distressLevel     DistressLevel @default(HIGH)
  triggerKeywords   String
  sentimentScore    Float
  transcriptSnippet String        @db.Text
  status            CrisisStatus  @default(OPEN)
  overrideReason    String?
  timestamp         DateTime      @default(now())

  @@index([schoolId])
  @@index([status])
  @@map("crisis_escalations")
}

// -------------------------------------------------------------
// FERPA / COPPA Immutable Audit Trail
// -------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  action    String
  category  String
  ipAddress String
  userAgent String
  details   String   @db.Text

  @@index([actorId])
  @@index([schoolId])
  @@index([timestamp])
  @@map("audit_logs")
}
